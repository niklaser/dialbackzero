[Unit]
Requires=dialback-zero-update-recovery.service
After=dialback-zero-update-recovery.service
Description=Dialback Zero status LEDs
Before=dialback-zero-modem.service
PartOf=dialback-zero.target

[Service]
Environment=PYTHONDONTWRITEBYTECODE=1
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/dialback-zero/led_daemon.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

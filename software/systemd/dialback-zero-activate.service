[Unit]
Requires=dialback-zero-update-recovery.service
After=dialback-zero-update-recovery.service
Description=Activate staged Dialback Zero settings
After=local-fs.target
Before=dialback-zero-modem.service dialback-zero-ppp-internet.service dialback-zero-ppp-hub.service dialback-zero-config.service
PartOf=dialback-zero.target

[Service]
Environment=PYTHONDONTWRITEBYTECODE=1
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/dialback-zero/activate_config.py
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
